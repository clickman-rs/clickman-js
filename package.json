{
  "name": "@clickman/js",
  "version": "0.1.1",
  "description": "Durable, privacy-filtered Clickman browser analytics SDK",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lockvoid/clickman-js.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/clickman.js"
    },
    "./global": "./dist/clickman.global.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "prepack": "pnpm build",
    "format": "prettier --write src tests scripts *.json *.md .github"
  },
  "dependencies": {
    "idb": "8.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vitest": "3.2.4"
  }
}
